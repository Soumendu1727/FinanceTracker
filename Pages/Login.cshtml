@page
@model LoginModel
<link rel="stylesheet" href="~/css/auth.css" />

<div class="auth-card">
    <h2>Welcome Back</h2>

    <form method="post">
        <div>
            <label>Email</label>
            <input type="email"
                   name="Email"
                   placeholder="Enter your email"
                   required />
        </div>

        <br />

        <div>
            <label>Password</label>
            <input type="password"
                   name="Password"
                   placeholder="Enter your password"
                   required />
        </div>

        <button type="submit">Login</button>
    </form>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="auth-error">@Model.Error</div>
    }

    <div class="auth-link">
        New user?
        <a href="/Register">Create an account</a>
    </div>
</div>
