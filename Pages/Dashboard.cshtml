@page
@model DashboardModel
<link rel="stylesheet" href="~/css/dashboard.css" />
<div class="dashboard-container">
<div class="dashboard-header">
    <h2>Dashboard</h2>

    <div class="header-actions">
        <!-- THEME TOGGLE -->
        <div class="theme-toggle">
            <span class="sun">☀️</span>

            <label class="switch">
                <input type="checkbox" id="themeToggle">
                <span class="slider"></span>
            </label>

            <span class="moon">🌙</span>
        </div>

        <!-- BACK / LOGOUT BUTTON -->
        <form method="get" action="/Login">
            <button class="back-btn">Logout</button>
        </form>
    </div>
</div>
<!-- 🔍 SEARCH -->
    <div class="search-box">
        <form method="get">

            <select name="SearchType">
                <option value="">All Types</option>
                <option value="Income">Income</option>
                <option value="Expense">Expense</option>
                <option value="Investment">Investment</option>
            </select>

            <input type="text" name="SearchText" placeholder="Category" value="@Model.SearchText" />

            <input type="number" step="0.01" name="SearchAmount" placeholder="Amount" />

            <input type="date" name="FromDate" />
            <input type="date" name="ToDate" />

            <button type="submit">Search</button>
            <a href="/Dashboard" class="clear-btn">Clear</a>
        </form>
    </div>
<div class="summary">
    <div class="summary-card">
        <span>Total Income</span>
        <strong>₹ @Model.TotalIncome</strong>
    </div>

    <div class="summary-card">
        <span>Total Expense</span>
        <strong>₹ @Model.TotalExpense</strong>
    </div>

    <div class="summary-card">
        <span>Savings</span>
        <strong>₹ @Model.Savings</strong>
    </div>

    <div class="summary-card">
        <span>Investment</span>
        <strong>₹ @Model.Investment</strong>
    </div>

</div>

<div class="add-form">
    <h3>Add Transaction</h3>
    <form method="post" action="/Dashboard">
        <select name="Type">
            <option value="Income">Income</option>
            <option value="Expense">Expense</option>
            <option value="Investment">Investment</option>
        </select>

        <input name="Category" placeholder="Category" />
        <input name="Amount" type="number" step="0.01" placeholder="Amount" />

        <button type="submit">Add</button>
    </form>
</div>

<h3>Transactions</h3>

<table>
    <tr>
        <th>Date & Time</th>
        <th>Type</th>
        <th>Category</th>
        <th>Amount</th>
        <th>Actions</th>
    </tr>

@foreach (var t in Model.Transactions)
{
    <tr>
        <td>@t.Date.ToString("yyyy-MM-dd HH:mm:ss")</td>
        <td>@t.Type</td>
        <td>@t.Category</td>
        <td>₹ @t.Amount</td>
        <td>
            <div class="actions">
                <form method="post" action="/Dashboard?handler=Edit">
                    <input type="hidden" name="id" value="@t.Id" />
                    <input name="category" value="@t.Category" />
                    <input name="amount" type="number" step="0.01" value="@t.Amount" />
                    <button class="update-btn">Update</button>
                </form>

                <form method="post" action="/Dashboard?handler=Delete">
                    <input type="hidden" name="id" value="@t.Id" />
                    <button class="delete-btn">Delete</button>
                </form>
            </div>
        </td>
    </tr>
}
</table>

</div>

<script>
    const toggle = document.getElementById("themeToggle");

    if (localStorage.getItem("theme") === "dark") {
        document.body.classList.add("dark");
        toggle.checked = true;
    }

    toggle.addEventListener("change", () => {
        document.body.classList.toggle("dark");
        localStorage.setItem(
            "theme",
            document.body.classList.contains("dark") ? "dark" : "light"
        );
    });
</script>

